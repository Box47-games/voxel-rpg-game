{
  "name": "voxel-rpg-game",
  "version": "2.1.1",
  "description": "Riftholm - a voxel settlement survival RPG built with React Three Fiber",
  "private": true,
  "homepage": "https://box47-games.github.io/voxel-rpg-game",
  "license": "UNLICENSED",
  "author": "Box47-games",
  "repository": {
    "type": "git",
    "url": "https://github.com/Box47-games/voxel-rpg-game.git"
  },
  "keywords": [
    "voxel",
    "rpg",
    "game",
    "react",
    "three.js",
    "3d",
    "magic",
    "dungeon"
  ],
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/rapier": "^1.5.0",
    "howler": "^2.2.4",
    "immer": "^11.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.187.0",
    "yaml": "^2.9.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "gh-pages": "^6.1.1",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "playwright": "1.65.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "vite": "^6.0.7",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "art": "node scripts/art/build.mjs",
    "art:portraits": "node scripts/art/portraits.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "lint": "eslint src/ --max-warnings 34",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\""
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": true
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
